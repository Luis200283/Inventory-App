<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="/css/index.css">
    <link rel="shortcut icon" href="icon.png" type="image/x-icon">
    <title>Inventory App</title>
</head>

<body>
    <header id="header">
        <div id="title">
            <img id="title-img" src="/icons/guitarras.svg" alt="">
            <div id="title-text">Allegro <br>Store</div>
        </div>
        <div id="ham-menu">
            <img src="/icons/clave.png" alt="">
        </div>
    </header>
    <div id="new-product">
        <h2>Add product</h2>
        <a id="add-button" href="/new">Add</a>
    </div>
    <div id="main">
        <div id="menu">
            <form action="/filter">
                <h3>Sort By Price</h3>
                <div class="filters">
                    <input type="radio" name="Sort" id="asc" value="asc" checked>
                    <Label for="Ascending">Ascending</Label>
                </div>
                <div class="filters">
                    <input type="radio" name="Sort" id="desc" value="desc">
                    <Label for="Descending">Descending</Label>
                </div>

                <h3>Filter by Instrument</h3>
                <div class="filters">
                    <input type="checkbox" name="Instrument" value="guitar" id="Guitar">
                    <Label for="Guitar">Guitar</Label>
                </div>
                <div class="filters">
                    <input type="checkbox" name="Instrument" value="Drum" id="Drum">
                    <Label for="Drum">Drum</Label>
                </div>
                <div class="filters">
                    <input type="checkbox" name="Instrument" value="Bass" id="Bass">
                    <Label for="Bass">Bass</Label>
                </div>

                <h3>Filter By Brand</h3>
                <div class="filters">
                    <input type="checkbox" name="Brands" value="Fender" id="Fender">
                    <Label for="Fender">Fender</Label>
                </div>
                <div class="filters">
                    <input type="checkbox" name="Brands" value="Ibanez" id="Ibanez">
                    <Label for="Ibanez">Ibanez</Label>
                </div>
                <div class="filters">
                    <input type="checkbox" name="Brands" value="Map" id="Map">
                    <Label for="Map">Map</Label>
                </div>
                <div class="filters">
                    <input type="checkbox" name="Brands" value="Dandree" id="Dandree">
                    <Label for="Dandree">Dandree</Label>
                </div>
                <div class="filters">
                    <input type="checkbox" name="Brands" value="Yamaha" id="Yamaha">
                    <Label for="Yamaha">Yamaha</Label>
                </div>
                <div class="filters">
                    <input type="checkbox" name="Brands" value="Casio" id="Casio">
                    <Label for="Casio">Casio</Label>
                </div>

                <button type="submit" id="applyFiltersButton">Apply Filters</button>
            </form>
        </div>
        <ul id="products-list">
            <% products.forEach(product => { %>
            <li class="product-card">
                <div class="product-img-container"><img class="product-img" src="<%= product.imgPath %>"></div>
                <ul>
                    <li><%= product.product_name %></li>
                    <li>color: <%= product.color %></li>
                    <li>Marca: <%= product.brand %></li>
                    <li>precio: <div class="product-tag"><%= product.price %>$</div>
                    </li>
                    <li>decripcion: <div class="product-description"><%= product.description %></div>
                    </li>
                    <li>tag: <div class="product-tag"><%= product.tag %></div>
                    </li>
                </ul>
            </li>
            <% }); %>
        </ul>
    </div>
</body>

</html>